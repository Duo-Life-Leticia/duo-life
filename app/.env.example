# Copie para .env.local (no computador) ou cadastre na Vercel (Settings > Environment Variables).
# Os dois valores ficam no Supabase: Project Settings > API.
# A chave "anon" é pública e pode ficar no app. NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chave pública das notificações no celular (par VAPID). A chave privada vai só nos segredos do Supabase.
VITE_VAPID_PUBLIC_KEY=
